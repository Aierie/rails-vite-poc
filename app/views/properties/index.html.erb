<div class="max-w-6xl mx-auto p-6">
  <h1 class="font-bold text-4xl mb-8 text-gray-800">Property Management System</h1>

  <% if @property %>
    <!-- Property Details -->
    <div class="bg-white shadow-lg rounded-lg p-6 mb-8">
      <h2 class="text-3xl font-bold text-blue-600 mb-4"><%= @property.name %></h2>
      <p class="text-gray-700 mb-2"><strong>Address:</strong> <%= @property.address %></p>
      <p class="text-gray-700"><strong>Description:</strong> <%= @property.description %></p>
    </div>

    <!-- Property Documents -->
    <% if @property.documents.any? %>
      <div class="bg-white shadow-lg rounded-lg p-6 mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Property Documents</h3>
        <div class="grid gap-4">
          <% @property.documents.each do |document| %>
            <div class="border-l-4 border-blue-500 pl-4 py-2">
              <p class="font-semibold text-lg"><%= document.title %></p>
              <p class="text-sm text-gray-600">Type: <%= document.document_type.capitalize %></p>
              <p class="text-gray-700 mt-2"><%= document.content %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Contractors -->
    <% if @property.contractors.any? %>
      <div class="bg-white shadow-lg rounded-lg p-6 mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Contractors</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <% @property.contractors.each do |contractor| %>
            <div class="border rounded-lg p-4 bg-gray-50">
              <h4 class="text-xl font-semibold text-green-600 mb-2"><%= contractor.name %></h4>
              <p class="text-gray-700 mb-3"><strong>Specialty:</strong> <%= contractor.specialty %></p>

              <% if contractor.documents.any? %>
                <div class="mt-3 pt-3 border-t border-gray-200">
                  <p class="text-sm font-semibold text-gray-600 mb-2">Documents:</p>
                  <% contractor.documents.each do |document| %>
                    <div class="bg-white rounded p-3 mb-2 border-l-4 border-green-500">
                      <p class="font-medium text-sm"><%= document.title %></p>
                      <p class="text-xs text-gray-600">Type: <%= document.document_type.capitalize %></p>
                      <p class="text-sm text-gray-700 mt-1"><%= document.content %></p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Lawyers -->
    <% if @property.lawyers.any? %>
      <div class="bg-white shadow-lg rounded-lg p-6 mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Legal Counsel</h3>
        <div class="grid md:grid-cols-2 gap-6">
          <% @property.lawyers.each do |lawyer| %>
            <div class="border rounded-lg p-4 bg-gray-50">
              <h4 class="text-xl font-semibold text-purple-600 mb-2"><%= lawyer.name %></h4>
              <p class="text-gray-700 mb-3"><strong>Firm:</strong> <%= lawyer.firm %></p>

              <% if lawyer.documents.any? %>
                <div class="mt-3 pt-3 border-t border-gray-200">
                  <p class="text-sm font-semibold text-gray-600 mb-2">Documents:</p>
                  <% lawyer.documents.each do |document| %>
                    <div class="bg-white rounded p-3 mb-2 border-l-4 border-purple-500">
                      <p class="font-medium text-sm"><%= document.title %></p>
                      <p class="text-xs text-gray-600">Type: <%= document.document_type.capitalize %></p>
                      <p class="text-sm text-gray-700 mt-1"><%= document.content %></p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Summary Card -->
    <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white shadow-lg rounded-lg p-6">
      <h3 class="text-xl font-bold mb-4">Summary</h3>
      <div class="grid md:grid-cols-4 gap-4">
        <div class="text-center">
          <p class="text-3xl font-bold"><%= @property.contractors.count %></p>
          <p class="text-sm">Contractors</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold"><%= @property.lawyers.count %></p>
          <p class="text-sm">Lawyers</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold"><%= @property.documents.count %></p>
          <p class="text-sm">Property Documents</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold"><%= @property.contractors.sum { |c| c.documents.count } + @property.lawyers.sum { |l| l.documents.count } %></p>
          <p class="text-sm">Associated Documents</p>
        </div>
      </div>
    </div>

  <% else %>
    <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded">
      <p class="font-bold">No properties found</p>
      <p>Please run <code class="bg-yellow-200 px-2 py-1 rounded">rails db:seed</code> to create sample data.</p>
    </div>
  <% end %>
</div>
